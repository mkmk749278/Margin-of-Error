  {
   "id": 0,
   "start": 0.0,
   "end": 5.23404255319149,
   "text": "Remember Alaska Airlines flight twelve eighty-two, the door plug that blew out over Portland?"
  },
  {
   "id": 1,
   "start": 5.999999999999999,
   "end": 7.9787234042553195,
   "text": "You may have heard it was a design flaw."
  },
  {
   "id": 2,
   "start": 8.51063829787234,
   "end": 12.297872340425533,
   "text": "The design had four bolts, where one lower bolt would have held it."
  },
  {
   "id": 3,
   "start": 12.808510638297872,
   "end": 15.25531914893617,
   "text": "On this airplane, all four were missing."
  },
  {
   "id": 4,
   "start": 15.851063829787234,
   "end": 18.106382978723403,
   "text": "Here's the N - T - S - B's report."
  },
  {
   "id": 5,
   "start": 18.680851063829785,
   "end": 20.978723404255316,
   "text": "Why they were missing is in the full investigation."
  },
  {
   "id": 6,
   "start": 21.93617021276596,
   "end": 22.680851063829788,
   "text": "Margin of Error."
  }
 ],
