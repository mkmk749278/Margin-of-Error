  {
   "id": 0,
   "start": 0.0,
   "end": 4.833333333333333,
   "text": "Remember the door plug that blew out of an Alaska Airlines Boeing seven thirty-seven nine?"
  },
  {
   "id": 1,
   "start": 5.479166666666667,
   "end": 10.9375,
   "text": "One hundred and eight days earlier, Boeing workers texted each other a photo of it, closed."
  },
  {
   "id": 2,
   "start": 11.687500000000002,
   "end": 12.6875,
   "text": "Here is what it showed."
  },
  {
   "id": 3,
   "start": 13.458333333333334,
   "end": 14.062500000000002,
   "text": "No bolts."
  },
  {
   "id": 4,
   "start": 14.541666666666668,
   "end": 15.250000000000002,
   "text": "No washers."
  },
  {
   "id": 5,
   "start": 15.666666666666666,
   "end": 16.208333333333336,
   "text": "No nuts."
  },
  {
   "id": 6,
   "start": 16.625000000000004,
   "end": 17.333333333333336,
   "text": "No pins."
  },
  {
   "id": 7,
   "start": 18.000000000000004,
   "end": 20.583333333333336,
   "text": "Why no one caught it is in the full investigation."
  },
  {
   "id": 8,
   "start": 21.333333333333336,
   "end": 22.0625,
   "text": "Margin of Error."
  }
 ],
