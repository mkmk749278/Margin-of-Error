 "sentences": [
  {
   "id": 0,
   "start": 0.0,
   "end": 4.25531914893617,
   "text": "Remember the door plug that blew out over Portland in January twenty twenty-four?"
  },
  {
   "id": 1,
   "start": 5.106382978723404,
   "end": 7.25531914893617,
   "text": "The failure didn't start on that flight."
  },
  {
   "id": 2,
   "start": 7.872340425531915,
   "end": 14.659574468085106,
   "text": "The N - T - S - B found the plug likely walked itself upward over one hundred and fifty-four flights."
  },
  {
   "id": 3,
   "start": 15.297872340425533,
   "end": 20.29787234042553,
   "text": "From outside, the change was about half an inch, too small to catch on a walk-around."
  },
  {
   "id": 4,
   "start": 20.914893617021278,
   "end": 24.085106382978722,
   "text": "How it stayed in that long is in the full investigation."
  },
  {
   "id": 5,
   "start": 25.085106382978722,
   "end": 25.872340425531913,
   "text": "Margin of Error."
  }
 ],
