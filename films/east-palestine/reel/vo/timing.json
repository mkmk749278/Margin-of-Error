 "sentences": [
  {
   "id": 0,
   "start": 0.0,
   "end": 2.2,
   "text": "Two numbers decided this town's week."
  },
  {
   "id": 1,
   "start": 2.92,
   "end": 6.24,
   "text": "East Palestine, Ohio, February twenty twenty-three."
  },
  {
   "id": 2,
   "start": 7.24,
   "end": 9.18,
   "text": "The first: one hundred and seventy."
  },
  {
   "id": 3,
   "start": 10.06,
   "end": 15.46,
   "text": "A detector beside the track read a bearing on fire at one hundred and three degrees above the air."
  },
  {
   "id": 4,
   "start": 15.84,
   "end": 18.44,
   "text": "The crew would only be told at one hundred and seventy."
  },
  {
   "id": 5,
   "start": 19.18,
   "end": 21.16,
   "text": "So in the cab: nothing."
  },
  {
   "id": 6,
   "start": 21.66,
   "end": 23.08,
   "text": "Where did that line come from?"
  },
  {
   "id": 7,
   "start": 23.38,
   "end": 29.62,
   "text": "It matches an industry definition that, the N - T - S - B found, relates to billing for repairs."
  },
  {
   "id": 8,
   "start": 30.34,
   "end": 33.2,
   "text": "Norfolk Southern says it also drew on its own experience."
  },
  {
   "id": 9,
   "start": 33.9,
   "end": 36.66,
   "text": "About forty minutes later, the axle came apart."
  },
  {
   "id": 10,
   "start": 37.58,
   "end": 40.46,
   "text": "Three days later came the second number: a temperature."
  },
  {
   "id": 11,
   "start": 41.08,
   "end": 47.56,
   "text": "Contractors told the incident commander that if a vinyl chloride tank car reached it, the reaction would run out of control."
  },
  {
   "id": 12,
   "start": 48.1,
   "end": 50.58,
   "text": "He said he was given thirteen minutes to decide."
  },
  {
   "id": 13,
   "start": 51.28,
   "end": 53.8,
   "text": "One number matched a definition written for billing."
  },
  {
   "id": 14,
   "start": 54.2,
   "end": 58.28,
   "text": "The other, the investigators could not find in the guidance used at the scene."
  },
  {
   "id": 15,
   "start": 58.76,
   "end": 61.96,
   "text": "What was decided on that number is in the full investigation."
  },
  {
   "id": 16,
   "start": 63.02,
   "end": 64.8,
   "text": "Margin of Error, on YouTube."
  }
 ],
