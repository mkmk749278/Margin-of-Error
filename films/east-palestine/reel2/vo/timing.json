 "sentences": [
  {
   "id": 0,
   "start": 0.0,
   "end": 2.86,
   "text": "Remember the train derailment in East Palestine, Ohio?"
  },
  {
   "id": 1,
   "start": 3.5,
   "end": 5.28,
   "text": "You've probably heard why it happened."
  },
  {
   "id": 2,
   "start": 5.78,
   "end": 6.72,
   "text": "A skipped repair."
  },
  {
   "id": 3,
   "start": 7.26,
   "end": 8.58,
   "text": "A bearing with no grease."
  },
  {
   "id": 4,
   "start": 9.22,
   "end": 9.76,
   "text": "Cost cutting."
  },
  {
   "id": 5,
   "start": 10.42,
   "end": 14.2,
   "text": "The N - T - S - B's final report doesn't confirm any of them."
  },
  {
   "id": 6,
   "start": 14.66,
   "end": 18.54,
   "text": "What it does show is stranger: where the warning line came from."
  },
  {
   "id": 7,
   "start": 19.04,
   "end": 19.78,
   "text": "Here's the report."
  },
  {
   "id": 8,
   "start": 20.28,
   "end": 22.18,
   "text": "The full investigation is on YouTube."
  },
  {
   "id": 9,
   "start": 22.94,
   "end": 23.88,
   "text": "Margin of Error."
  }
 ],
